<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="pl.polsatgranie.dailycytato.ui.home.HomeFragment"
        android:label="Cytaty"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_preferences"
        android:name="pl.polsatgranie.dailycytato.ui.preferences.PreferencesFragment"
        android:label="Preferencje"
        tools:layout="@layout/fragment_preferences" />

    <fragment
        android:id="@+id/navigation_account"
        android:name="pl.polsatgranie.dailycytato.ui.account.AccountFragment"
        android:label="Konto"
        tools:layout="@layout/fragment_account" />
